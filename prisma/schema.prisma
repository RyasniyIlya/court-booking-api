generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Пулене з'єднання (PgBouncer, transaction mode) — для запитів застосунку.
  url       = env("DATABASE_URL")
  // Пряме з'єднання в обхід пулера — тільки для migrate/introspect. Advisory
  // lock, на якому тримається `prisma migrate deploy`, ненадійно живе через
  // transaction-pooling: сесія може розпастись між стейтментами, і лок або
  // не береться, або виглядає зайнятим назавжди (P1002). Neon і Prisma обидва
  // документують саме це як причину — https://pris.ly/d/migrate-advisory-locking
  directUrl = env("DIRECT_URL")
}

enum BookingStatus {
  /// Або чекає підтвердження адміна, або чекає оплати (тоді заповнено expiresAt)
  PENDING
  CONFIRMED
  CANCELLED
  /// Не оплатив за відведений час. Слот звільняється — EXCLUDE-констрейнт
  /// не рахує EXPIRED зайнятим.
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum BookingSource {
  WIDGET
  ADMIN
}

enum UserRole {
  OWNER
  ADMIN
  /// Доступ тільки до власного розкладу (свої заняття як тренера).
  /// Не бачить клієнтів інших тренерів, білінг і налаштування клубу.
  TRAINER
}

/// Спортивний клуб = один тенант SaaS
model Club {
  id              String  @id @default(uuid()) @db.Uuid
  name            String
  slug            String  @unique
  /// IANA-таймзона, напр. "Europe/Kyiv". Уся конвертація рахується від неї.
  timezone        String  @default("Europe/Kyiv")
  /// Телефон адміністратора. Показується у шапці віджета посиланням tel:
  phone           String?
  /// Адреса клубу для шапки віджета: "Київ, вул. Хрещатик, 1"
  address         String?
  /// Логотип для шапки віджета. Абсолютний https-URL на чужому хостингу
  /// або на боці клубу — файли ми не зберігаємо.
  logoUrl         String?
  /// Акцентний колір клубу, #RRGGBB. Ним фарбуються кнопки, вибір у сітці
  /// й фокус — і у віджеті, і в кабінеті. Статусні кольори (підтверджено /
  /// чекає / скасовано) НЕ брендуються навмисно: якби вони бралися звідси,
  /// у клубу з вишневим «Підтверджено» злилося б зі «Скасувати».
  /// null = кортовий зелений за замовчуванням (web/src/lib/brand.js).
  brandColor      String?
  /// Крок сітки за замовчуванням, хв
  slotMinutes     Int     @default(60)
  /// За скільки хвилин до старту ще можна забронювати онлайн
  leadTimeMinutes Int     @default(60)
  /// За скільки хвилин до старту закривається САМОСТІЙНЕ скасування
  /// гравцем — і броні корту, і місця в груповому занятті.
  ///
  /// 0 (типово) — можна аж до початку: рівно та поведінка, що була до
  /// появи цього поля, тож наявним клубам нічого не змінюється мовчки.
  /// Клуб, який готує зал і рахує людей заздалегідь, ставить, скажімо,
  /// 300 — за п'ять годин місце вже нікуди не подінеться.
  ///
  /// Скасування адміністратором цим не обмежується: клуб домовляється
  /// з гравцем голосом і має могти зняти запис будь-коли.
  cancelCutoffMinutes Int @default(0)
  /// На скільки днів уперед відкрита сітка
  horizonDays     Int     @default(14)
  /// Чи бронь одразу CONFIRMED, чи чекає підтвердження адміна
  autoConfirm     Boolean @default(true)
  /// Куди слати сповіщення про нову бронь
  telegramChatId  String?

  // ── Передоплата ──────────────────────────────────────────────────────
  /// Чи взагалі доступна онлайн-оплата в цьому клубі.
  prepayEnabled   Boolean @default(false)
  /// true (за замовчуванням, щоб не змінити поведінку наявних клубів
  /// мовчки) — оплата обов'язкова, бронь чекає її. false — гравець сам
  /// обирає при бронюванні: оплатити зараз чи на місці.
  prepayRequired  Boolean @default(true)
  /// 'mono' | 'mock'. mock — заглушка для локальної розробки
  paymentProvider String?
  /// Токен еквайрингу КЛУБУ, зашифрований AES-256-GCM (див. src/lib/crypto.ts).
  /// Гроші йдуть на рахунок клубу, ми не посередник у розрахунках.
  paymentTokenEnc String?
  /// Скільки хвилин тримати слот під неоплачену бронь
  payHoldMinutes  Int     @default(15)

  isActive    Boolean   @default(true)
  trialEndsAt DateTime?

  // ── Наше обслуговування ──────────────────────────────────────────────
  // Це НАШІ гроші з клубу, а не гроші гравців за корти. Гравці платять на
  // рахунок клубу через його ж еквайринг — ми в тих розрахунках не беремо
  // участі взагалі. Плутати ці дві сутності не можна, тому й окрема
  // модель ClubInvoice, а не record у Payment.
  //
  /// До якої дати оплачене обслуговування. null = ще не платили жодного разу
  /// (свіже впровадження — перший рік зазвичай входить у встановлення).
  paidUntil     DateTime?
  /// На який строк клуб платить зазвичай. Впливає тільки на підказки
  /// в кабінеті й на суму в рахунку — стан рахує paidUntil.
  billingPeriod BillingPeriod @default(MONTH)
  /// Для нас: «платить раз на рік», «ФОП, рахунок на пошту», «готівкою».
  /// Клубу не показується.
  billingNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courts     Court[]
  hours      ClubHours[]
  bookings   Booking[]
  blocks     Block[]
  users      User[]
  customers  Customer[]
  passes     Pass[]
  payments   Payment[]
  trainers   Trainer[]
  invoices   ClubInvoice[]
  expenses   ClubExpense[]
  /// Коли ми підтвердили клуб після реєстрації. null = чекає на дзвінок/оплату.
  /// Впливає на віддачу даних для публічного віджета.
  approvedAt DateTime?
}

enum ExpenseCategory {
  SALARY
  RENT
  BANK_FEE
  UTILITIES
  OTHER
}

/// Витрати клубу — вводяться власником вручну (зарплати, оренда, комісія
/// банку тощо), щоб аналітика могла показати не тільки виручку, а й чистий
/// прибуток. Свідомо без автоматичного розрахунку комісії банку: у нас
/// немає даних про тарифи еквайрингу кожного провайдера, тож це теж просто
/// рядок витрат, який власник вводить сам.
model ClubExpense {
  id     String @id @default(uuid()) @db.Uuid
  clubId String @db.Uuid
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  /// Перше число місяця, до якого належить витрата. Час не має значення —
  /// витрата завжди місячна, а не прив'язана до конкретного дня.
  month    DateTime        @db.Date
  category ExpenseCategory
  /// Довільний підпис: "Зарплата адміністратора Марії", "Оренда"
  label    String
  /// Копійки
  amount   Int

  createdAt DateTime @default(now())

  @@index([clubId, month])
}

/// Період оплати обслуговування. Клуб обирає сам: комусь зручніше щомісяця
/// дрібними сумами, комусь — раз на рік і забути.
enum BillingPeriod {
  MONTH
  QUARTER
  YEAR
}

enum InvoiceStatus {
  /// Виставлений, чекає оплати
  ISSUED
  PAID
  /// Скасований — помилка у сумі, домовились інакше
  VOID
}

/// Рахунок клубу за наше обслуговування.
///
/// Навмисно НЕ `Payment`: та модель — про гроші гравців за корти, і сплутати
/// їх означає одного дня показати клубу його виручку як наш борг.
///
/// Оплата поки приходить поза системою — переказом, посиланням у Telegram
/// або готівкою. Тому тут немає ні токена, ні вебхука: `paidAt` і `method`
/// проставляються руками, коли гроші дійшли. Своє автосписання заводити
/// заради 500 грн не варто — воно потребує еквайрингу, який ми свідомо
/// не заводимо.
model ClubInvoice {
  id     String @id @default(uuid()) @db.Uuid
  clubId String @db.Uuid
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  /// За який період. Саме вони, а не дата оплати, посувають Club.paidUntil
  periodFrom DateTime
  periodTo   DateTime
  /// Копійки, як і всюди в проєкті
  amount     Int
  status     InvoiceStatus @default(ISSUED)
  /// 'transfer' | 'link' | 'cash' — вільний рядок, щоб не робити міграцію
  /// щоразу, коли з'явиться новий спосіб
  method     String?
  note       String?

  issuedAt DateTime  @default(now())
  paidAt   DateTime?

  @@index([clubId, periodTo])
}

/// Тренер клубу.
///
/// Робочих годин і відпусток свідомо не ведемо — клуб сам знає, хто коли
/// працює, а повноцінний розклад тренерів це вже CRM, куди ми не лізем.
/// Від накладок захищає перевірка при створенні броні (див. routes/public.ts):
/// у віджеті видно тільки вільних на цю годину.
model Trainer {
  id     String @id @default(uuid()) @db.Uuid
  clubId String @db.Uuid
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  name         String
  phone        String?
  /// Ставка за годину в копійках. Додається до ціни корту.
  pricePerHour Int     @default(0)
  /// Для адміністратора: «дитяча група», «тільки падел»
  note         String?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings      Booking[]
  staffAccounts User[]
  notes         Note[]

  @@index([clubId, isActive])
}

enum NoteSubject {
  TRAINER
  COURT
}

/// Один рушій нотаток на дві сутності — тренер і корт. Раніше це був окремий
/// TrainerNote тільки для тренерів; коли ту саму потребу озвучили для
/// кортів (розміри, для кого — і окремо відгук з оцінкою), дублювати
/// модель+роути+компонент сенсу не було. Різниться тільки:
///   - де шукати сутність (trainerId або courtId — рівно один заповнений,
///     другий null; Prisma не робить справжніх поліморфних relation,
///     тому пара nullable-колонок замість однієї);
///   - чи можна лишити оцінку (rating — тільки для відгуку на корт).
///
/// Не плутати з Trainer.note чи майбутнім Court.note — ті одні й публічні,
/// летять у віджет як категорія («дитяча група», «ґрунт»). Тут — приватний
/// журнал персоналу: пишуть OWNER/ADMIN під PIN, старі записи не
/// переписуються. Сам тренер свою справу тільки читає.
model Note {
  id      String      @id @default(uuid()) @db.Uuid
  subject NoteSubject

  trainerId String?  @db.Uuid
  trainer   Trainer? @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  courtId   String?  @db.Uuid
  court     Court?   @relation(fields: [courtId], references: [id], onDelete: Cascade)

  text   String
  /// 1–5. Заповнено тільки для відгуку на корт (subject = COURT) — нотатки
  /// тренера й довідкові записи корту («розмір 20×40, для дітей») без оцінки.
  rating Int?

  /// SetNull, а не Cascade: звільнення автора (модератора) не має стирати
  /// те, що він написав — запис лишається, тільки без активного посилання.
  authorId String? @db.Uuid
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  /// Знімок на момент запису. Автора можуть звільнити або він сам піде —
  /// "хто написав" має лишитись читабельним і без JOIN, що може повернути null.
  authorEmail String
  authorRole  UserRole

  createdAt DateTime @default(now())

  @@index([subject, trainerId, createdAt])
  @@index([subject, courtId, createdAt])
}

/// Розклад роботи по днях тижня (0 = неділя ... 6 = субота)
model ClubHours {
  id          String  @id @default(uuid()) @db.Uuid
  clubId      String  @db.Uuid
  club        Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  weekday     Int
  /// Хвилини від опівночі за локальним часом клубу: 08:00 -> 480
  openMinute  Int
  closeMinute Int
  isClosed    Boolean @default(false)

  @@unique([clubId, weekday])
}

model Court {
  id           String  @id @default(uuid()) @db.Uuid
  clubId       String  @db.Uuid
  club         Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name         String
  /// Ціна за годину в копійках. 45000 = 450,00 грн
  pricePerHour Int     @default(0)
  /// Перевизначає Club.slotMinutes, якщо задано
  slotMinutes  Int?
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)

  bookings Booking[]
  blocks   Block[]
  notes    Note[]

  @@index([clubId, isActive])
}

model Booking {
  id      String @id @default(uuid()) @db.Uuid
  /// Денормалізовано навмисно: усі адмінські вибірки йдуть по клубу
  clubId  String @db.Uuid
  club    Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  courtId String @db.Uuid
  court   Court  @relation(fields: [courtId], references: [id], onDelete: Cascade)

  /// Копія на момент броні — імʼя в картці клієнта може змінитись пізніше.
  ///
  /// Nullable з появою групових занять: у контейнера групи одного клієнта
  /// немає, там замість імені `title` («Ранкова йога»), а люди лежать у
  /// BookingSeat. Що саме заповнене — стежить CHECK booking_private_or_group,
  /// тож «ні імені, ні назви» база просто не прийме.
  customerName  String?
  /// Нормалізований E.164
  customerPhone String?
  comment       String?

  // ── Групове заняття ──────────────────────────────────────────────────
  // Групове — це ОДНА бронь корту, до якої записуються люди. Так корт
  // лишається зайнятим рівно один раз, і booking_no_overlap (EXCLUDE)
  // продовжує захищати від подвійного продажу години без жодних винятків.
  //
  /// Скільки місць усього. null = звичайна приватна бронь корту.
  capacity     Int?
  /// Назва заняття для віджета: «Ранкова йога», «Дитяча група 8–10».
  /// Заповнена рівно тоді, коли заповнена capacity.
  title        String?
  /// Ціна одного місця, копійки. У групи priceTotal — це ціна корту,
  /// а гравець платить саме стільки.
  pricePerSeat Int?

  seats BookingSeat[]

  /// Картка клієнта. Nullable: історичні броні до впровадження обліку
  customerId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// Тренер на це заняття. null = грають самі.
  /// SetNull, а не Cascade: звільнення тренера не має стирати історію броней.
  trainerId    String?  @db.Uuid
  trainer      Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  /// Скільки з priceTotal — робота тренера. Зафіксовано на момент броні:
  /// ставка тренера може змінитись, а сплачено було стільки.
  trainerPrice Int      @default(0)

  /// Завжди UTC
  startTime DateTime @db.Timestamptz(3)
  endTime   DateTime @db.Timestamptz(3)

  status      BookingStatus @default(CONFIRMED)
  source      BookingSource @default(WIDGET)
  /// Зафіксована ціна на момент броні, копійки
  priceTotal  Int           @default(0)
  /// Токен для самостійного скасування клієнтом за посиланням.
  /// Ним же віджет питає статус оплати після повернення з платіжки.
  cancelToken String        @unique @default(uuid())

  /// Заповнено тільки для броні, що чекає оплати. Після цього моменту
  /// фонова задача переведе бронь у EXPIRED і слот звільниться.
  /// null = звичайна бронь, яка не протухає.
  expiresAt DateTime? @db.Timestamptz(3)

  /// Серія повторюваних занять: «щовівторка о 19:00». null = одиночна бронь.
  ///
  /// Свідомо просте групування через uuid, а не окрема таблиця Series.
  /// Кожне заняття лишається самостійною бронню: його можна перенести,
  /// скасувати або перепризначити тренера, не чіпаючи решту серії.
  /// Окрема таблиця знадобилась би тільки для правила «змінити всю серію
  /// одним рухом» — а це вже CRM, куди ми не лізем.
  seriesId String? @db.Uuid

  payment Payment?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?

  @@index([clubId, startTime])
  @@index([courtId, startTime])
  @@index([status, expiresAt])
  @@index([trainerId, startTime])
  @@index([seriesId])
}

enum SeatStatus {
  /// Місце за гравцем. Рахується і в зайнятих, і у виручці заняття.
  BOOKED
  /// Місце тримається під оплату (заповнено expiresAt). Місткість займає:
  /// інакше поки гравець платить, те саме місце продали б удруге.
  PENDING
  CANCELLED
  /// Не оплатив за відведений час. Місце повертається у вільні — рівно те
  /// саме, що EXPIRED у Booking, тільки для місця в групі.
  EXPIRED
}

/// Одне місце в груповому занятті — один записаний гравець.
///
/// Навмисно не Booking: місце не займає корт (його вже зайняв контейнер
/// групи) і не має власного інтервалу часу. Якби місця були бронями,
/// booking_no_overlap відхилив би друге ж місце — а саме він і тримає
/// головну гарантію схеми.
///
/// Скасоване місце лишається рядком, а не видаляється: клуб має бачити,
/// хто записався й передумав, інакше «нас було восьмеро, чому порожньо»
/// не буде на що відповісти.
model BookingSeat {
  id        String  @id @default(uuid()) @db.Uuid
  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// Картка клієнта — та сама, що й у звичайній броні. Nullable з тієї ж
  /// причини: історія важливіша за звʼязок, який може зникнути.
  customerId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// Копії на момент запису, як і в Booking
  customerName  String
  /// Нормалізований E.164
  customerPhone String
  comment       String?

  status SeatStatus    @default(BOOKED)
  source BookingSource @default(WIDGET)
  /// Зафіксована ціна місця на момент запису, копійки
  price  Int           @default(0)

  /// Скасування за посиланням — так само, як у звичайної броні.
  /// Ним же віджет питає статус оплати після повернення з платіжки.
  cancelToken String @unique @default(uuid())

  /// Заповнено тільки поки місце чекає онлайн-оплати. Після цього моменту
  /// прибирання (lib/expire.ts) переведе місце в EXPIRED і звільнить його.
  /// null = місце оплачується на місці й не протухає.
  expiresAt DateTime? @db.Timestamptz(3)

  /// Оплата саме за це місце. Не плутати з оплатою самого заняття:
  /// контейнер групи корт нікому не продає, платять учасники поштучно.
  payment Payment?

  createdAt   DateTime  @default(now())
  cancelledAt DateTime?

  @@index([bookingId, status])
  @@index([customerId])
  /// Для прибирання неоплачених місць — той самий патерн, що й у Booking
  @@index([status, expiresAt])
}

/// Платіж. Один до одного з тим, за що заплачено: часткових оплат немає —
/// 100% передоплата.
///
/// «Те, за що заплачено» — рівно одне з двох: приватна бронь корту або одне
/// місце в груповому занятті. Третього не дано, і за цим стежить CHECK
/// payment_booking_or_seat.
///
/// Чому не один bookingId на все. Групове заняття — це ОДНА бронь корту на
/// вісьмох людей. Якби місце платило через bookingId, унікальність «один
/// платіж на бронь» довелось би зняти зовсім — і зникла б гарантія, що
/// приватну бронь не оплатять двома рахунками. Друга nullable-колонка
/// зберігає обидві: NULL у Postgres не конфліктує з NULL, тому @unique на
/// кожній працює рівно там, де вона потрібна.
model Payment {
  id        String       @id @default(uuid()) @db.Uuid
  clubId    String       @db.Uuid
  club      Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  /// Приватна бронь корту. null — платять за місце в групі.
  bookingId String?      @unique @db.Uuid
  booking   Booking?     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  /// Місце в груповому занятті. null — платять за бронь корту.
  seatId    String?      @unique @db.Uuid
  seat      BookingSeat? @relation(fields: [seatId], references: [id], onDelete: Cascade)

  /// 'mono' | 'mock'
  provider    String
  /// invoiceId на боці провайдера
  providerRef String
  /// Сторінка оплати, куди відправляємо гравця
  pageUrl     String?

  /// Копійки. Дублюємо суму броні навмисно: ціна корту може змінитись,
  /// а сплачено було стільки.
  amount Int
  /// ISO 4217, 980 = гривня
  ccy    Int @default(980)

  status     PaymentStatus @default(PENDING)
  /// modifiedDate з вебхука. Провайдер не гарантує порядок доставки,
  /// тому старіший вебхук не має перетирати новіший стан.
  providerAt DateTime?
  paidAt     DateTime?
  /// Коли клуб натиснув «Повернути гроші» й банк прийняв запит.
  ///
  /// Не те саме, що refundedAt: гроші повернулись тоді, коли про це сказав
  /// вебхук, а не тоді, коли ми попросили. Між цими двома моментами
  /// проходять секунди у моно й можуть пройти дні у поганий день — і весь
  /// цей час кабінет має показувати «повернення в дорозі», а не пропонувати
  /// натиснути кнопку вдруге.
  refundRequestedAt DateTime?
  refundedAt DateTime?
  failReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Захист від повторної обробки того самого інвойса
  @@unique([provider, providerRef])
  @@index([clubId, status])
}

/// Блокування часу: ремонт, турнір, тривога, техперерва
model Block {
  id        String   @id @default(uuid()) @db.Uuid
  clubId    String   @db.Uuid
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  /// null = блокується весь клуб
  courtId   String?  @db.Uuid
  court     Court?   @relation(fields: [courtId], references: [id], onDelete: Cascade)
  reason    String?
  startTime DateTime @db.Timestamptz(3)
  endTime   DateTime @db.Timestamptz(3)

  createdAt DateTime @default(now())

  @@index([clubId, startTime])
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  clubId       String   @db.Uuid
  club         Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String
  role         UserRole @default(OWNER)
  createdAt    DateTime @default(now())
  pinModerHash String?

  /// ПІН режиму власника (рівень 3). bcrypt.
  pinOwnerHash String?

  /// Захист від перебору: 4 цифри підбираються за хвилини.
  pinFails       Int       @default(0)
  pinLockedUntil DateTime?

  /// Прив'язка акаунта TRAINER до картки тренера — визначає, чиї заняття
  /// він бачить у /bookings. SetNull, а не Cascade: звільнення тренера
  /// не має ламати сам акаунт (гасити його — окрема дія).
  trainerId String?  @db.Uuid
  trainer   Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  writtenNotes Note[]
}

enum PassType {
  /// Пакет занять: 10 тренувань
  PACKAGE
  /// Безліміт на період: місяць
  UNLIMITED
}

/// Картка учасника клубу. Створюється автоматично при першій броні —
/// жодної реєстрації з боку клієнта не потрібно, ідентифікатор = телефон.
model Customer {
  id     String @id @default(uuid()) @db.Uuid
  clubId String @db.Uuid
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  name      String
  /// Нормалізований E.164, напр. +380671234567
  phone     String
  /// Останні 7 цифр — пошук на ресепшені за 4+ цифрами
  phoneTail String

  telegramChatId String?
  note           String?
  /// Чорний список: не пускати онлайн-бронювання
  isBlocked      Boolean @default(false)

  /// Мітки клубу: «діти», «ранкова група», «тренується з Марією», «боржник».
  ///
  /// Вільний список рядків, а не довідник: у кожного клубу свій словник, і
  /// таблиця-довідник тут дала б окремий екран її ведення заради того, що
  /// адміністратор і так наберає з клавіатури. Порожній масив — типово,
  /// тож наявним карткам нічого не змінюється.
  ///
  /// Не плутати з `tier` в аналітиці: той рахується сам із відвідувань і
  /// руками не ставиться. Мітка — те, чого система знати не може.
  tags           String[] @default([])

  /// Особистий кабінет гравця: телефон + PIN, той самий патерн, що й PIN
  /// персоналу в User. Не пароль і не SMS-код — жодного зовнішнього
  /// провайдера відправки не додаємо. null = кабінет ще не заведено,
  /// гравець просто вводить ім'я й телефон щоразу, як і раніше.
  pinHash        String?
  pinFails       Int       @default(0)
  pinLockedUntil DateTime?
  /// HMAC(PIN) — швидкий детермінований відбиток лише для перевірки
  /// унікальності PIN у межах клубу. НЕ використовується для входу (для
  /// цього bcrypt-порівняння з pinHash) — сам по собі він нічого не пускає,
  /// тільки дозволяє БД миттєво відхилити дубль замість перебору bcrypt
  /// по всіх клієнтах клубу.
  pinLookupHash  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
  passes   Pass[]
  /// Місця в групових заняттях — окремо від bookings: там бронь корту,
  /// тут запис у чужу бронь.
  seats    BookingSeat[]

  /// Телефон унікальний у межах клубу, а не глобально:
  /// одна людина може ходити у два клуби — це різні картки.
  @@unique([clubId, phone])
  /// Один PIN — один клієнт клубу. NULL не бере участі в унікальності
  /// (у Postgres NULL != NULL), тому клієнтів без кабінету це не чіпає.
  @@unique([clubId, pinLookupHash])
  @@index([clubId, phoneTail])
}

model Pass {
  id         String   @id @default(uuid()) @db.Uuid
  clubId     String   @db.Uuid
  club       Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type PassType

  /// Для PACKAGE: скільки занять куплено. Для UNLIMITED — null
  totalSessions Int?
  /// Скільки використано. Списання = інкремент, тому історія не втрачається
  usedSessions  Int  @default(0)

  validFrom  DateTime @db.Timestamptz(3)
  validUntil DateTime @db.Timestamptz(3)

  /// Сплачено, копійки
  price Int @default(0)

  createdAt DateTime  @default(now())
  /// Скасований адміном достроково
  revokedAt DateTime?

  usages PassUsage[]

  @@index([clubId, customerId])
  @@index([clubId, validUntil])
}

/// Кожне списання — окремий запис. Дозволяє скасувати списання,
/// показати клієнту історію і не сперечатись з ним «я не ходив».
model PassUsage {
  id         String    @id @default(uuid()) @db.Uuid
  passId     String    @db.Uuid
  pass       Pass      @relation(fields: [passId], references: [id], onDelete: Cascade)
  /// Бронь, за яку списано. Null = списано вручну адміном
  bookingId  String?   @unique @db.Uuid
  usedAt     DateTime  @default(now())
  /// Хто списав: SYSTEM або email адміна
  by         String    @default("SYSTEM")
  revertedAt DateTime?

  @@index([passId])
}
