# Приклад оточення. Реальні значення — тільки у .env, який у .gitignore.
# У цьому файлі не має бути жодного справжнього секрету.

# Postgres (Neon). Пулений рядок (з "-pooler" у хості) — для запитів застосунку.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"

# Той самий Neon, але БЕЗ "-pooler" у хості. Обов'язковий: advisory lock, на
# якому тримається `prisma migrate deploy`, ненадійно живе через PgBouncer
# transaction-pooling — без цього деплой падає з P1002.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Підпис JWT кабінету. Будь-який довгий випадковий рядок.
# Згенерувати: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET="change-me"

# Звідки пускати кабінет адміністратора (CORS). Кома як роздільник.
# Наприклад: https://court-booking.vercel.app
ADMIN_ORIGINS=""

# Оператор платформи — не клуб, окремий вхід у /platform.
PLATFORM_ADMIN_EMAIL=""
# bcrypt-хеш пароля, не сам пароль. Згенерувати:
# node -e "require('bcryptjs').hash('пароль', 12).then(console.log)"
PLATFORM_ADMIN_PASSWORD_HASH=""

# Ключ шифрування токенів еквайрингу клубів (AES-256-GCM).
# Мінімум 16 символів. УВАГА: зміна ключа робить збережені токени
# нечитабельними — клубам доведеться ввести їх заново.
PAYMENTS_SECRET=""

# Публічна адреса цього API. Потрібна для webHookUrl платіжки.
# Локально — http://localhost:3000, на проді — адреса з Render.
PUBLIC_API_URL="http://localhost:3000"

# Запасна адреса повернення з платіжки, якщо віджет не передав свою.
PUBLIC_WIDGET_RETURN_URL=""

# Бот. Порожньо — сповіщення не шлються, бот не запускається, API живе далі.
TELEGRAM_BOT_TOKEN=""

# Ім'я бота без @ — кабінет робить із нього посилання t.me/... на кнопці
# «Підключити Telegram». Порожньо — покажемо просто код, який треба
# надіслати боту вручну.
TELEGRAM_BOT_USERNAME=""

# Як бот отримує повідомлення.
#
# ПОРОЖНЬО (локально) — long polling. Публічна адреса не потрібна, бот
# сам опитує Telegram. Один процес на бота: якщо запустити два API з тим
# самим токеном, оновлення почнуть ділитись між ними випадково.
#
# ЗАДАНО (прод) — вебхук на цю адресу. Має закінчуватись на
# /api/telegram/webhook і бути https. Секрет обов'язковий: Telegram шле
# його заголовком, і без збігу ми відповідаємо 401.
TELEGRAM_WEBHOOK_URL=""
TELEGRAM_WEBHOOK_SECRET=""

# О котрій годині боту слати власнику зведення дня — ЗА ЧАСОМ КЛУБУ, а не
# сервера. Порожньо — 21:00. У понеділок разом зі зведенням приходить ще й
# графік виручки за минулий тиждень.
DIGEST_HOUR="21"

# Пароль демо-учітки для npm run db:seed. За замовчуванням demo1234.
DEMO_PASSWORD=""
